# clang-tidy configuration for include/, src/ and the tests below them.
#
# Run it explicitly:
#   run-clang-tidy-18 -p build/dev-viewer -quiet '/src/'
#
# Correctness modules are enabled as a whole, style rules as an explicit
# allowlist. A toolchain upgrade may therefore introduce new bug checks, but
# never a new opinion about how code should look.
---
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  performance-*,
  -bugprone-easily-swappable-parameters,
  -performance-enum-size,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-special-member-functions,
  llvm-namespace-comment,
  misc-const-correctness,
  modernize-avoid-c-arrays,
  modernize-use-nodiscard,
  readability-identifier-naming,
  readability-implicit-bool-conversion,
  readability-isolate-declaration,
  readability-redundant-casting,
  readability-uppercase-literal-suffix

# Left out on purpose, each measured against this code base rather than picked
# from a style guide:
#
#   readability-identifier-length          single-letter maths names are sanctioned
#   modernize-use-trailing-return-type     leading return types are the convention here
#   readability-braces-around-statements   fights AllowShortIfStatementsOnASingleLine
#   readability-magic-numbers              a formula's constants are the formula
#   cppcoreguidelines-avoid-magic-numbers  same check, second name
#   modernize-return-braced-init-list      hides the returned type at the call site
#   misc-non-private-member-variables-in-classes   Interval and Aabb expose theirs on purpose
#   modernize-use-auto                     explicit types are preferred here
#   cppcoreguidelines-pro-bounds-constant-array-index   asserts already guard these indices
#   cppcoreguidelines-avoid-const-or-ref-data-members   reference members are a deliberate contract
#   bugprone-easily-swappable-parameters   unavoidable in geometry constructors
#   readability-named-parameter            unnamed parameters mark intentionally unused ones
#   misc-no-recursion                      every recursion here is deliberate
#   performance-enum-size                  no measurable gain, only noise
#   cppcoreguidelines-pro-type-vararg      third-party C APIs are variadic
#   cppcoreguidelines-pro-type-reinterpret-cast     required at the C API boundary
#   cppcoreguidelines-pro-bounds-pointer-arithmetic same boundary
#   readability-function-cognitive-complexity        arbitrary threshold
#   readability-redundant-member-init      the initializers satisfy -Wmissing-field-initializers
#   readability-convert-member-functions-to-static   ImGui state is global, the wrapper is not
#   cppcoreguidelines-virtual-class-destructor       protected non-virtual base dtor is the idiom
#   misc-include-cleaner                   clangd already enforces this in the editor

# Which headers report diagnostics. Vendored, vcpkg and system headers arrive
# through -isystem and stay silent regardless.
HeaderFilterRegex: '.*/(include/pt|src|tests)/.*'

# Only consulted when --fix rewrites code, so replacements stay formatted.
FormatStyle: file

CheckOptions:
  # An abstract base whose only special member is a defaulted destructor is not
  # a rule-of-five violation.
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true

  # The rules below encode docs/style-guide.md. Types are PascalCase.
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase

  # Lowercase, unlike types: most enumerators mirror an external lowercase token
  # (scene format operators, CLI format and log-level names, keyboard keys).
  readability-identifier-naming.EnumConstantCase: lower_case
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TypeTemplateParameterCase: CamelCase
  readability-identifier-naming.ValueTemplateParameterCase: CamelCase
  readability-identifier-naming.TemplateTemplateParameterCase: CamelCase

  # Functions and methods are snake_case.
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.MethodCase: lower_case
  readability-identifier-naming.ConstexprFunctionCase: lower_case
  readability-identifier-naming.ConstexprMethodCase: lower_case

  # Variables and parameters are snake_case, with no prefix or suffix.
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.LocalVariableCase: lower_case
  readability-identifier-naming.GlobalVariableCase: lower_case
  readability-identifier-naming.StaticVariableCase: lower_case

  # Constants are snake_case at every scope; constexpr is a property of the
  # definition, not of the name. Every scope is listed explicitly, which leaves
  # the generic ConstantCase and ConstantMemberCase deliberately unset: either
  # of them would take priority over the access-based rules below, and a const private
  # member would lose its trailing underscore. Constness is not part of a name here.
  readability-identifier-naming.ConstexprVariableCase: lower_case
  readability-identifier-naming.GlobalConstantCase: lower_case
  readability-identifier-naming.StaticConstantCase: lower_case
  readability-identifier-naming.LocalConstantCase: lower_case
  readability-identifier-naming.ClassConstantCase: lower_case
  readability-identifier-naming.ConstantParameterCase: lower_case

  # Public members carry no suffix; private and protected ones carry a trailing
  # underscore, which is what makes -Wshadow-all usable.
  readability-identifier-naming.PublicMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberCase: lower_case
  readability-identifier-naming.ProtectedMemberSuffix: '_'
  readability-identifier-naming.PrivateMemberCase: lower_case
  readability-identifier-naming.PrivateMemberSuffix: '_'

  # Namespaces are lowercase; macros shout, because they ignore scope.
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
