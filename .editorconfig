root = true

# C++ layout is owned by .clang-format, Rust by rustfmt.
# indent_size here must stay in sync with them.

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[{CMakeLists.txt,*.cmake,*.json,*.yml,*.yaml,*.toml}]
indent_size = 2

[*.md]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown
trim_trailing_whitespace = false