{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "PT_BUILD_VIEWER": "OFF",
        "PT_DOUBLE_PRECISION": "OFF"
      }
    },
    {
      "name": "dev",
      "displayName": "Development (Debug, warnings as errors)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "dev-viewer",
      "displayName": "Development + interactive viewer",
      "inherits": "dev",
      "cacheVariables": {
        "PT_BUILD_VIEWER": "ON",
        "VCPKG_MANIFEST_FEATURES": "viewer"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Sanitizers (ASan + UBSan)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-O1 -fno-omit-frame-pointer -fsanitize=address,undefined -fno-sanitize-recover=all"
      }
    },
    {
      "name": "release",
      "displayName": "Release (optimized, portable)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-native",
      "displayName": "Release (native arch, this machine only)",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-march=native"
      }
    },
    {
      "name": "release-viewer",
      "displayName": "Release + interactive viewer",
      "inherits": "release",
      "cacheVariables": {
        "PT_BUILD_VIEWER": "ON",
        "VCPKG_MANIFEST_FEATURES": "viewer"
      }
    },
    {
      "name": "release-stats",
      "displayName": "Release + BVH statistics (measurement only)",
      "inherits": "release",
      "cacheVariables": {
        "PT_ENABLE_STATS": "ON"
      }
    },
    {
      "name": "release-profiling",
      "displayName": "Release + profiling symbols (measurement only)",
      "inherits": "release",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-g -fno-omit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "dev-viewer",
      "configurePreset": "dev-viewer"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "release-native",
      "configurePreset": "release-native"
    },
    {
      "name": "release-viewer",
      "configurePreset": "release-viewer"
    },
    {
      "name": "release-stats",
      "configurePreset": "release-stats"
    },
    {
      "name": "release-profiling",
      "configurePreset": "release-profiling"
    }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "dev",
      "inherits": "test-base",
      "configurePreset": "dev"
    },
    {
      "name": "dev-viewer",
      "inherits": "test-base",
      "configurePreset": "dev-viewer"
    },
    {
      "name": "asan-ubsan",
      "inherits": "test-base",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "release",
      "inherits": "test-base",
      "configurePreset": "release"
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        }
      ]
    },
    {
      "name": "asan-ubsan",
      "steps": [
        {
          "type": "configure",
          "name": "asan-ubsan"
        },
        {
          "type": "build",
          "name": "asan-ubsan"
        },
        {
          "type": "test",
          "name": "asan-ubsan"
        }
      ]
    }
  ]
}
