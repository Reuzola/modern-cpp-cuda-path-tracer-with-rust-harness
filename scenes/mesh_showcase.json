{
  "$schema": "../schema/scene.schema.json",
  "version": 1,
  "camera": {
    "lookfrom": [0, 1.5, 6],
    "lookat": [0, 0.25, 0],
    "vfov": 30
  },
  "render": {
    "width": 400,
    "height": 300,
    "samples_per_pixel": 64,
    "max_depth": 24,
    "background": [0.05, 0.06, 0.09]
  },
  "textures": {
    "checker": {
      "type": "checker",
      "scale": 0.5,
      "even": { "type": "solid_color", "albedo": [0.2, 0.22, 0.25] },
      "odd": { "type": "solid_color", "albedo": [0.75, 0.75, 0.72] }
    },
    "lamp": { "type": "solid_color", "albedo": [12, 11, 9] }
  },
  "materials": {
    "floor": { "type": "lambertian", "texture": "checker" },
    "brass": { "type": "metal", "albedo": [0.78, 0.62, 0.28], "fuzz": 0.05 },
    "glass": { "type": "dielectric", "refraction_index": 1.5 },
    "light": { "type": "diffuse_light", "texture": "lamp" }
  },
  "objects": [
    { "type": "quad", "q": [-8, -1, -8], "u": [16, 0, 0], "v": [0, 0, 16], "material": "floor" },
    {
      "type": "translate",
      "offset": [-1.4, -0.5, 0],
      "object": {
        "type": "rotate_y",
        "angle": 25,
        "object": { "type": "mesh", "filename": "../assets/unit_cube.obj", "material": "brass" }
      }
    },
    {
      "type": "translate",
      "offset": [1.3, 0, 0],
      "object": { "type": "mesh", "filename": "../assets/tetrahedron.obj", "material": "glass" }
    },
    {
      "type": "quad",
      "name": "ceiling_light",
      "q": [-1.5, 4, -1.5],
      "u": [3, 0, 0],
      "v": [0, 0, 3],
      "material": "light"
    }
  ],
  "importance_targets": ["ceiling_light"]
}
