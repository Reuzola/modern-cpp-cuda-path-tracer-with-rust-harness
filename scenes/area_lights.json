{
  "$schema": "../schema/scene.schema.json",
  "version": 1,
  "camera": {
    "lookfrom": [26, 3, 6],
    "lookat": [0, 2, 0],
    "vup": [0, 1, 0],
    "vfov": 20,
    "defocus_angle": 0,
    "focus_dist": 10
  },
  "render": {
    "width": 400,
    "height": 225,
    "samples_per_pixel": 100,
    "max_depth": 50,
    "background": [0, 0, 0]
  },
  "textures": {
    "perlin": { "type": "noise", "scale": 4, "seed": 1 },
    "emission": { "type": "solid_color", "albedo": [4, 4, 4] }
  },
  "materials": {
    "perlin": { "type": "lambertian", "texture": "perlin" },
    "light": { "type": "diffuse_light", "texture": "emission" }
  },
  "objects": [
    { "type": "sphere", "center": [0, -1000, 0], "radius": 1000, "material": "perlin" },
    { "type": "sphere", "center": [0, 2, 0], "radius": 2, "material": "perlin" },
    { "type": "quad", "q": [3, 1, -2], "u": [2, 0, 0], "v": [0, 2, 0], "material": "light" },
    { "type": "sphere", "center": [0, 7, 0], "radius": 2, "material": "light" }
  ]
}