{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "pathtracer",
  "version": "1.0.0",
  "description": "Physically-based path tracer",
  "license": "MIT",
  "dependencies": [
    "catch2",
    "cli11",
    "nlohmann-json",
    "openexr",
    "tinyobjloader"
  ],
  "features": {
    "viewer": {
      "description": "Interactive GLFW viewer (PT_BUILD_VIEWER=ON)",
      "dependencies": [
        "glfw3",
        {
          "name": "glad",
          "features": ["gl-api-33", "loader"]
        },
        {
          "name": "imgui",
          "features": ["glfw-binding", "opengl3-binding"]
        }
      ]
    }
  },
  "builtin-baseline": "6d9d7df564a1ccdaa994e4ad39ccd4a32360867b"
}
